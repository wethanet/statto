# Vite web app
# Copy these values to web/.env.local for local development.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Auth email for local config push / local Supabase.
# Do not put these in web/.env.local because Vite exposes VITE_* values to the browser.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=no-reply@auth.example.com

# Supabase Edge Function email reminders.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Warners Bay Bulldogs <no-reply@example.com>"
